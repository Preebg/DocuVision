{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Verification UI with loopback API access and scoped IPC commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-read-local-api-token",
    "allow-operator-session-keyring",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
