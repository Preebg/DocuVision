{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local LAN verification UI — no cloud hosts; only loopback and private subnets.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-read-local-api-token",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://192.168.*:*" },
        { "url": "http://10.*:*" },
        { "url": "http://172.16.*:*" },
        { "url": "http://172.17.*:*" },
        { "url": "http://172.18.*:*" },
        { "url": "http://172.19.*:*" },
        { "url": "http://172.2*:*" },
        { "url": "http://172.30.*:*" },
        { "url": "http://172.31.*:*" }
      ]
    }
  ]
}
