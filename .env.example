# Copy to .env and adjust. Compose loads these automatically.

# Ollama — Mini PC on LAN, or host Docker Desktop:
#   DOCUVISION_OLLAMA_BASE_URL=http://192.168.1.50:11434
# With --profile ollama:
#   DOCUVISION_OLLAMA_BASE_URL=http://ollama:11434
DOCUVISION_OLLAMA_BASE_URL=http://host.docker.internal:11434
DOCUVISION_OLLAMA_PRIMARY_MODEL=qwen3-vl:8b-thinking
DOCUVISION_OLLAMA_FALLBACK_MODEL=qwen2.5vl:3b
DOCUVISION_OLLAMA_WARMUP=true

# Persistence — set a Postgres DSN for pooled Postgres; leave empty for SQLite.
# DOCUVISION_DATABASE_URL=postgresql://docuvision:docuvision@localhost:5432/docuvision
# DOCUVISION_SQLITE_PATH=/data/docuvision.db

# Optional path overrides (local disk or SMB/NFS mounts):
# DOCUVISION_DATA_ROOT=C:\Projects\DocuVision\data
# DOCUVISION_INCOMING_DIR=/mnt/share/incoming
# DOCUVISION_VERIFICATION_DIR=/mnt/share/verification

# Sole FastAPI entrypoint (python run_api.py) — local default 127.0.0.1:8000
# DOCUVISION_API_HOST=127.0.0.1
# DOCUVISION_API_PORT=8000

# FastAPI CORS for the static SPA / Tauri host
# DOCUVISION_API_CORS_ORIGINS=http://localhost:3000,tauri://localhost

# Local loopback API handshake (P0 auth gate).
# When unset, run_api.py mints a session token into:
#   Windows: %LOCALAPPDATA%\DocuVision\token.lock
#   macOS:   ~/Library/Application Support/DocuVision/token.lock
#   Linux:   ${XDG_STATE_HOME:-~/.local/state}/DocuVision/token.lock
# For browser/dev without Tauri, set BOTH to the same value:
# LOCAL_API_KEY=dev-local-handshake-key
# NEXT_PUBLIC_LOCAL_API_KEY=dev-local-handshake-key

# Static Next.js SPA → local FastAPI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Clerk identity for verify/reject audit (LAN username, workstation id, or email).
# Operators can also override via localStorage key docuvision_operator_identity.
# NEXT_PUBLIC_OPERATOR_IDENTITY=DOMAIN\\jsmith

WEB_PORT=3000
