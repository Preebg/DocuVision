# Copy to .env and adjust. Compose loads these automatically.

# Ollama — Mini PC on LAN, or host Docker Desktop:
#   DOCUVISION_OLLAMA_BASE_URL=http://192.168.1.50:11434
# With --profile ollama:
#   DOCUVISION_OLLAMA_BASE_URL=http://ollama:11434
DOCUVISION_OLLAMA_BASE_URL=http://host.docker.internal:11434
DOCUVISION_OLLAMA_PRIMARY_MODEL=qwen3-vl:8b-thinking
DOCUVISION_OLLAMA_FALLBACK_MODEL=qwen2.5vl:3b
DOCUVISION_OLLAMA_WARMUP=true

# Next.js verification UI (Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://urxjqixxdxknwlccwwok.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key_here

WEB_PORT=3000
